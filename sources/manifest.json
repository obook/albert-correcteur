{
  "manifest_version": 2,
  "name": "Albert Correcteur",
  "version": "0.1.0",
  "description": "Correcteur orthographique et grammatical français propulsé par l'API Albert (DINUM).",
  "browser_specific_settings": {
    "gecko": {
      "id": "albert-correcteur@ac-bordeaux.fr",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://albert.api.etalab.gouv.fr/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup/popup.html",
    "default_title": "Albert Correcteur"
  },
  "options_ui": {
    "page": "popup/popup-settings.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "albert-state.js",
        "albert-utils.js",
        "albert-badge.js",
        "albert-render.js",
        "albert-popup.js",
        "albert-apply.js",
        "albert-check.js",
        "albert-main.js"
      ],
      "css": [
        "css/badge.css",
        "css/overlay.css",
        "css/popup-dark.css",
        "css/popup-light.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
