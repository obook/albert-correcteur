{
  "manifest_version": 2,
  "name": "Albert Correcteur",
  "version": "0.8.2",
  "description": "Extension de correction orthographique, grammaticale et de traduction pour Thunderbird, propulsée par l'API Albert (DINUM).",
  "author": "Olivier Booklage",
  "homepage_url": "https://forge.apps.education.fr/booklageolivier/albert-correcteur",
  "browser_specific_settings": {
    "gecko": {
      "id": "albert-correcteur-thunderbird@ac-bordeaux.fr",
      "update_url": "https://forge.apps.education.fr/booklageolivier/albert-correcteur/-/raw/main/updates.json",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "permissions": [
    "compose",
    "messagesRead",
    "messagesModify",
    "storage",
    "menus",
    "activeTab",
    "clipboardWrite",
    "https://albert.api.etalab.gouv.fr/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup-configuration/popup.html",
    "default_title": "Albert",
    "default_area": "maintoolbar"
  },
  "options_ui": {
    "page": "popup-configuration/popup-settings.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "util/blancs.js",
      "util/model-aliases.js",
      "util/personas.js",
      "service/service-update.js",
      "service/service-config.js",
      "service/service-langue.js",
      "service/service-prompts.js",
      "service/service-limites.js",
      "service/service-fallback.js",
      "service/service-rate-limit.js",
      "verification/regles-locales.js",
      "service/service-api.js",
      "service/service-dispatch.js",
      "service/service-message-scripts.js",
      "service/service-menus.js",
      "service/service-compose-scripts.js",
      "service/service-compose-cleanup.js"
    ]
  }
}
