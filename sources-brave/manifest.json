{
  "manifest_version": 3,
  "name": "Albert Correcteur",
  "version": "0.8.6",
  "description": "Extension expérimentale de correction orthographique, grammaticale et de traduction française propulsée par l'API Albert (DINUM).",
  "author": "Olivier Booklage",
  "homepage_url": "https://forge.apps.education.fr/booklageolivier/albert-correcteur",
  "minimum_chrome_version": "109",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://albert.api.etalab.gouv.fr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup-configuration/popup.html",
    "default_title": "Albert Correcteur"
  },
  "options_ui": {
    "page": "popup-configuration/popup-settings.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "service/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.svg",
        "icons/icon-ok.svg",
        "icons/icon-error.svg"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/browser-shim.js",
        "util/ui-root.js",
        "etat/albert-state.js",
        "util/blancs.js",
        "etat/albert-fields.js",
        "etat/albert-paragraphes.js",
        "etat/albert-offsets.js",
        "etat/albert-utils.js",
        "affichage/albert-badge.js",
        "util/lang-names.js",
        "affichage/albert-render-arialive.js",
        "affichage/albert-render-overlay.js",
        "affichage/albert-render.js",
        "util/popup-focus.js",
        "util/popup-base.js",
        "popup-contenu/albert-popup-common.js",
        "popup-contenu/popup-layout.js",
        "popup-contenu/albert-popup-correction.js",
        "popup-contenu/albert-popup-reformulation.js",
        "popup-contenu/popup-traduction.js",
        "popup-contenu/albert-popup-messages.js",
        "util/inner-text.js",
        "correction/albert-apply-segments.js",
        "correction/albert-apply-rich.js",
        "correction/albert-apply.js",
        "util/ui-root.js",
        "notification/toast.js",
        "verification/rolling-window.js",
        "verification/albert-limites.js",
        "verification/albert-debounce.js",
        "verification/albert-check.js",
        "demarrage/albert-main.js"
      ],
      "css": [
        "css/badge-base.css",
        "css/badge.css",
        "css/overlay.css",
        "css/popup-dark.css",
        "css/popup-light.css",
        "css/toast.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
