{
  "manifest_version": 2,
  "name": "Albert Correcteur",
  "version": "0.2.23",
  "description": "Extension expérimentale de correction orthographique, grammaticale et de traduction française propulsée par l'API Albert (DINUM).",
  "browser_specific_settings": {
    "gecko": {
      "id": "albert-correcteur@ac-bordeaux.fr",
      "update_url": "https://forge.apps.education.fr/booklageolivier/albert-correcteur/-/raw/main/updates.json",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "https://albert.api.etalab.gouv.fr/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup-configuration/popup.html",
    "default_title": "Albert Correcteur"
  },
  "options_ui": {
    "page": "popup-configuration/popup-settings.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": [
      "service/service-config.js",
      "service/service-langue.js",
      "service/service-prompts.js",
      "service/service-limites.js",
      "service/service-api.js",
      "service/service-menus.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "etat/albert-state.js",
        "etat/albert-utils.js",
        "affichage/albert-badge.js",
        "affichage/albert-render-arialive.js",
        "affichage/albert-render-overlay.js",
        "affichage/albert-render.js",
        "popup-contenu/albert-popup-common.js",
        "popup-contenu/albert-popup-layout.js",
        "popup-contenu/albert-popup-correction.js",
        "popup-contenu/albert-popup-reformulation.js",
        "popup-contenu/albert-popup-traduction.js",
        "popup-contenu/albert-popup-messages.js",
        "correction/albert-apply-segments.js",
        "correction/albert-apply-rich.js",
        "correction/albert-apply.js",
        "notification/albert-toast.js",
        "verification/albert-limites.js",
        "verification/albert-debounce.js",
        "verification/albert-check.js",
        "demarrage/albert-main.js"
      ],
      "css": [
        "css/badge.css",
        "css/overlay.css",
        "css/popup-dark.css",
        "css/popup-light.css",
        "css/toast.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
